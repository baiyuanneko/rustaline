# 复制为 .env 后按需修改。应用启动时自动加载 .env（dotenvy）。
#
# 覆盖 config/default.toml 的两种方式：
#   1. 嵌套覆盖：APP_<段>__<键>，例如 APP_SERVER__PORT=9000
#   2. 常用项的单层简写（见下，等价于对应的嵌套写法）

# 数据库连接串（默认 SQLite，文件不存在时自动创建）
# PostgreSQL: postgres://user:pass@localhost:5432/bynrust26
# MySQL:      mysql://user:pass@localhost:3306/bynrust26
APP_DATABASE_URL=sqlite://./data/bynrust26.db?mode=rwc

# Redis 连接串（JWT 黑名单使用）
APP_REDIS_URL=redis://127.0.0.1:6379

# JWT 签名密钥：必填，启动时校验（拒绝已知弱默认值，要求 ≥32 字节）。
# 用 `openssl rand -base64 48` 生成后填在这里；缺失或过弱时应用启动失败。
# APP_JWT_SECRET=

# 管理员初始账号（唯一用户）：仅在首次启动、数据库 admins 表为空时作为种子写入；
# 入库后这两个变量被完全忽略（改密码在管理面板「设置」页操作），届时可从本文件移除。
# 表为空且未设置时应用启动失败。
# APP_INITIAL_ADMIN_USERNAME=admin
# APP_INITIAL_ADMIN_PASSWORD=please-change-me

# access token 有效期（秒），默认 86400（24h）
# APP_JWT_TTL_SECS=86400

# 是否启用 Redis JWT 黑名单（true/false）。启用时 Redis 不可达会导致启动失败
# APP_JWT_BLACKLIST_ENABLED=true

# 监听地址与端口
# APP_SERVER_HOST=0.0.0.0
# APP_SERVER_PORT=8080

# 反向代理部署时采信 X-Forwarded-For 推导真实客户端 IP（取最右侧条目），
# 限流桶 / 评论 ip 落库 / 验证码 IP 绑定随之按真实客户端生效；默认 false。
# 仅当 app 不可被外部直连、仅经反代可达时才可置 true，否则客户端可伪造 XFF 绕过限流
# APP_TRUST_XFF=false

# 日志级别（tracing env-filter 语法），如 info,debug,sea_orm=warn
# APP_LOG_LEVEL=info

# 静态文件目录（兜底挂载在根路径）
# APP_STATIC_DIR=static

# 演示首页开关（true/false）：false 时访问 / 返回 307 跳转 /admin/，
# 管理面板左下角「演示页」入口会提示已被禁用
# APP_ENABLE_INTRODUCTION_INDEX=true

# 邮箱头像 CDN（gravatar 协议镜像）；置空 = 禁用邮箱头像层，仅剩 QQ 头像 + 前端首字母兜底
# APP_AVATAR_CDN=https://gravatar.loli.net/avatar/

# 是否在公共评论响应中下发 UA 解析摘要（ua_summary，如 "Chrome 126 · Windows"），
# SDK 会在评论旁显示评论者浏览器/系统徽章；默认 true，置 false 可关闭
# APP_DISPLAY_COMMENTER_USER_AGENT=true

# Swagger UI / OpenAPI 文档开关（true/false）：false 时 /swagger-ui 与 /api-doc/openapi.json 不再挂载（404），
# 管理面板「Swagger UI」入口点击会弹窗提示已禁用
# APP_ENABLE_SWAGGER_UI=true

# ---- 评论验证码（PoW / 图形验证码，默认均开启；两者独立，同时开启为 AND）----
# PoW 工作量证明开关：SDK 在浏览器后台静默计算 SHA-256 hashcash，正常用户无感。
# 置 false 可回到旧行为（仅限流 + 蜜罐 + 审核）
# APP_COMMENT_POW_ENABLED=true
# PoW 难度（哈希十六进制前导零位数，1..=8；4 ≈ 6.5 万次、5 ≈ 100 万次）
# APP_COMMENT_POW_DIFFICULTY=4
# PoW challenge 有效期（秒）
# APP_COMMENT_POW_TTL_SECS=600

# 图形验证码开关：开启后 SDK 表单出现图片验证码输入框
# APP_COMMENT_CAPTCHA_IMAGE_ENABLED=true
# 图形码有效期（秒）、单码最大错误尝试次数
# APP_COMMENT_CAPTCHA_IMAGE_TTL_SECS=300
# APP_COMMENT_CAPTCHA_IMAGE_MAX_ATTEMPTS=3

# PoW challenge 是否绑定签发 IP（true 时换网络需重新获取；防代理池共享预解）
# APP_COMMENT_CAPTCHA_BIND_IP=false
# challenge HMAC 签名密钥：留空时自动由 APP_JWT_SECRET 域分离派生；需要独立密钥时：
# APP_COMMENT_CAPTCHA_SECRET=
#   openssl rand -base64 48
