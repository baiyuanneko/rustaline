# 复制为 .env 后按需修改。应用启动时自动加载 .env（dotenvy）。
#
# 覆盖 config/default.toml 的两种方式：
#   1. 嵌套覆盖：APP_<段>__<键>，例如 APP_SERVER__PORT=9000
#   2. 常用项的单层简写（见下，等价于对应的嵌套写法）

# 数据库连接串（默认 SQLite，文件不存在时自动创建）
# PostgreSQL: postgres://user:pass@localhost:5432/bynrust26
# MySQL:      mysql://user:pass@localhost:3306/bynrust26
APP_DATABASE_URL=sqlite://./data/bynrust26.db?mode=rwc

# Redis 连接串（JWT 黑名单使用）
APP_REDIS_URL=redis://127.0.0.1:6379

# JWT 签名密钥：必填，启动时校验（拒绝已知弱默认值，要求 ≥32 字节）。
# 用 `openssl rand -base64 48` 生成后填在这里；缺失或过弱时应用启动失败。
# APP_JWT_SECRET=

# 管理员初始账号（唯一用户）：仅在首次启动、数据库 admins 表为空时作为种子写入；
# 入库后这两个变量被完全忽略（改密码在管理面板「设置」页操作），届时可从本文件移除。
# 表为空且未设置时应用启动失败。
# APP_INITIAL_ADMIN_USERNAME=admin
# APP_INITIAL_ADMIN_PASSWORD=please-change-me

# access token 有效期（秒），默认 86400（24h）
# APP_JWT_TTL_SECS=86400

# 是否启用 Redis JWT 黑名单（true/false）。启用时 Redis 不可达会导致启动失败
# APP_JWT_BLACKLIST_ENABLED=true

# 监听地址与端口
# APP_SERVER_HOST=0.0.0.0
# APP_SERVER_PORT=8080

# 日志级别（tracing env-filter 语法），如 info,debug,sea_orm=warn
# APP_LOG_LEVEL=info

# 静态文件目录（兜底挂载在根路径）
# APP_STATIC_DIR=static

# 邮箱头像 CDN（gravatar 协议镜像）；置空 = 禁用邮箱头像层，仅剩 QQ 头像 + 前端首字母兜底
# APP_AVATAR_CDN=https://gravatar.loli.net/avatar/
